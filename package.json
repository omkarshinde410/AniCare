    "dotenv": "^17.0.1",
    "express": "^5.1.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^2.5.0",
    "leaflet": "^1.9.4",
    "morgan": "^1.10.0",
    "prisma": "^6.5.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.1.0",
    "ws": "^8.21.3",
    "zod": "^4.0.0"
